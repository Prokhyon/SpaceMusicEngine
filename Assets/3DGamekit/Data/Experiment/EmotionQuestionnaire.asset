  m_Script: {fileID: 11500000, guid: dba4b69eab47a4739aa9b937594ff8c7, type: 3}
  m_Name: EmotionQuestionnaire
  m_EditorClassIdentifier: Assembly-CSharp::Gamekit3D.Experiment.QuestionnaireDefinition
  title: "\xC9valuation \xE9motionnelle"
  items:
  - id: affective_slider_intro
    text: "En pensant \xE0 l'ensemble du niveau que vous venez de jouer\u2026"
    type: 6
    options: []
    required: 1
    reverseScored: 0
  - id: valence
    text: "Valence (1 = Tr\xE8s d\xE9plaisant, 7 = Tr\xE8s plaisant)"
    type: 4
    options: []
    required: 1
    reverseScored: 0
  - id: arousal
    text: "Arousal (1 = Tr\xE8s calme / endormi, 7 = Tr\xE8s activ\xE9 / excit\xE9)"
    type: 4
    options: []
    required: 1
    reverseScored: 0
  - id: gems_explo_intro
    text: "Pensez aux moments o\xF9 vous exploriez l'environnement, sans ennemi imm\xE9diatement
      pr\xE9sent ou mena\xE7ant. \nPour chacune des sensations ci-dessous, indiquez
      \xE0 quel point vous l'avez ressentie pendant ces moments."
    type: 6
    options: []
    required: 1
    reverseScored: 0
  - id: explo_serenity
    text: "S\xE9r\xE9nit\xE9 (s\xE9r\xE9nit\xE9 \xB7 calme \xB7 apaisement)"
    type: 0
    options:
    - Pas du tout
    - "L\xE9g\xE8rement"
    - "Mod\xE9r\xE9ment"
    - Beaucoup
    - "Extr\xEAmement"
    required: 1
    reverseScored: 0
  - id: explo_wonder
    text: "\xC9merveillement (\xE9merveillement \xB7 fascination \xB7 \xE9tonnement)"
    type: 0
    options:
    - Pas du tout
    - "L\xE9g\xE8rement"
    - "Mod\xE9r\xE9ment"
    - Beaucoup
    - "Extr\xEAmement"
    required: 1
    reverseScored: 0
  - id: explo_transcendence
    text: "Transcendance (profond\xE9ment \xE9mu \xB7 touch\xE9 \xB7 frissons)"
    type: 0
    options:
    - Pas du tout
    - "L\xE9g\xE8rement"
    - "Mod\xE9r\xE9ment"
    - Beaucoup
    - "Extr\xEAmement"
    required: 1
    reverseScored: 0
  - id: explo_tension
    text: "Tension (tension \xB7 nervosit\xE9 \xB7 anxi\xE9t\xE9)"
    type: 0
    options:
    - Pas du tout
    - "L\xE9g\xE8rement"
    - "Mod\xE9r\xE9ment"
    - Beaucoup
    - "Extr\xEAmement"
    required: 1
    reverseScored: 0
  - id: gems_combat_intro
    text: "Pensez maintenant aux moments de combat, lorsque vous affrontiez des ennemis.
      \nPour chacune des sensations ci-dessous, indiquez \xE0 quel point vous l'avez
      ressentie pendant ces moments."
    type: 6
    options: []
    required: 1
    reverseScored: 0
  - id: combat_tension
    text: "Tension (tension \xB7 nervosit\xE9 \xB7 anxi\xE9t\xE9)"
