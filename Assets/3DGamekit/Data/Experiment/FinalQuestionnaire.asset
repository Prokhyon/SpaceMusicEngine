  m_Script: {fileID: 11500000, guid: dba4b69eab47a4739aa9b937594ff8c7, type: 3}
  m_Name: FinalQuestionnaire
  m_EditorClassIdentifier: Assembly-CSharp::Gamekit3D.Experiment.QuestionnaireDefinition
  title: Questions finales
  items:
  - id: immersion_compare
    text: "Dans quel niveau aviez-vous l'impression d'\xEAtre le plus absorb\xE9
      ou immerg\xE9 ?"
    type: 0
    options:
    - Niveau 1
    - Niveau 2
    - "\xC9quivalent"
    required: 1
    reverseScored: 0
  - id: time_compare
    text: "Dans quel niveau le temps vous a-t-il sembl\xE9 passer le plus vite ?"
    type: 0
    options:
    - Niveau 1
    - Niveau 2
    - "\xC9quivalent"
    required: 1
    reverseScored: 0
  - id: focus_compare
    text: "Dans quel niveau votre concentration vous a-t-elle sembl\xE9 la plus soutenue
      ?"
    type: 0
    options:
    - Niveau 1
    - Niveau 2
    - "\xC9quivalent"
    required: 1
    reverseScored: 0
  - id: music_diff_noticed
    text: "Avez-vous remarqu\xE9 des diff\xE9rences entre les ambiances sonores ou
      musicales des deux niveaux ?"
    type: 0
    options:
    - Oui
    - Non
    - "Je ne suis pas s\xFBr(e)"
    required: 1
    reverseScored: 0
  - id: music_diff_desc
    text: "Si oui, pouvez-vous d\xE9crire ce que vous avez per\xE7u ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
  - id: music_influence
    text: "La musique ou le son a-t-il influenc\xE9 votre fa\xE7on de jouer ou votre
      ressenti ?"
    type: 0
    options:
    - Oui
    - Non
    - "Peut-\xEAtre"
    required: 1
    reverseScored: 0
  - id: music_influence_desc
    text: "Si oui, de quelle fa\xE7on ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
  - id: felt_difference
    text: "Pensez-vous avoir ressenti la diff\xE9rence pendant le jeu ? Dans quel
      sens ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
  - id: marking_moment
    text: "Quel moment du jeu vous a le plus marqu\xE9, et pourquoi ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
  - id: distraction
    text: "Y a-t-il quelque chose qui vous a distrait ou sorti du jeu \xE0 un moment
      ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
  - id: general_remarks
    text: "Avez-vous des remarques g\xE9n\xE9rales sur l'exp\xE9rience ?"
    type: 2
    options: []
    required: 0
    reverseScored: 0
