  m_Script: {fileID: 11500000, guid: dba4b69eab47a4739aa9b937594ff8c7, type: 3}
  m_Name: PreQuestionnaire
  m_EditorClassIdentifier: Assembly-CSharp::Gamekit3D.Experiment.QuestionnaireDefinition
  title: "Questionnaire pr\xE9-session"
  items:
  - id: age
    text: "Quel est votre \xE2ge ?"
    type: 3
    options: []
    required: 1
    reverseScored: 0
  - id: gender
    text: Quel est votre genre ?
    type: 0
    options:
    - Homme
    - Femme
    - Non-binaire
    - "Pr\xE9f\xE8re ne pas r\xE9pondre"
    required: 1
    reverseScored: 0
  - id: hours_per_week
    text: "Combien d'heures par semaine jouez-vous \xE0 des jeux vid\xE9o en moyenne
      ?"
    type: 0
    options:
    - Moins d'1h
    - "1\u20133h"
    - "3\u20137h"
    - "7\u201315h"
    - Plus de 15h
    required: 1
    reverseScored: 0
  - id: game_types
    text: "Quel type de jeux pratiquez-vous principalement ? (r\xE9ponse multiple)"
    type: 1
    options:
    - Action
    - RPG
    - FPS
    - Puzzle
    - Plateforme
    - Aucun
    - Autre
    required: 1
    reverseScored: 0
  - id: tpp_experience
    text: "Avez-vous d\xE9j\xE0 jou\xE9 \xE0 un jeu en vue \xE0 la troisi\xE8me personne
      avec combats et exploration ?"
    type: 0
    options:
    - Oui
    - Non
    required: 1
    reverseScored: 0
  - id: music_training
    text: Avez-vous une formation musicale ou pratiquez-vous un instrument ?
    type: 0
    options:
    - Oui, en amateur
    - "Oui, de fa\xE7on avanc\xE9e"
    - Non
    required: 1
    reverseScored: 0
  - id: music_sensitivity
    text: "Comment d\xE9cririez-vous votre sensibilit\xE9 habituelle \xE0 la musique
      dans les jeux vid\xE9o ?"
    type: 0
    options:
    - "Je ne pr\xEAte g\xE9n\xE9ralement pas attention \xE0 la musique"
    - "Je la remarque sans qu'elle m'affecte particuli\xE8rement"
    - Elle influence nettement mon ressenti pendant le jeu
    required: 1
    reverseScored: 0
